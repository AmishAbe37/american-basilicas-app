{
  "expo": {
    "name": "American Basilicas",
    "slug": "american-basilicas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "americanbasilicas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.americanbasilicas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used on this phone to list the basilicas nearest you. It isn't sent or saved."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f2e7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "org.americanbasilicas.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f2e7"
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used on this phone to list the basilicas nearest you. It isn't sent or saved.",
          "locationAlwaysAndWhenInUsePermission": "American Basilicas uses your location only while the app is open, to list the basilicas nearest you. It isn’t sent or saved.",
          "locationAlwaysPermission": "American Basilicas uses your location only while the app is open, to list the basilicas nearest you. It isn’t sent or saved."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of a basilica to add to your visit. Your visit photos are reviewed for the members’ gallery. Location data is removed before upload.",
          "cameraPermission": "Take photos at a basilica for your visit. Your visit photos are reviewed for the members’ gallery. Location data is removed before upload.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "americanbasilicasorg",
    "description": "A pilgrim's map of the 94 Catholic minor basilicas of the United States.",
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/94f5432c-2f5c-47ca-9268-81e9c1ad65a4"
    },
    "extra": {
      "eas": {
        "projectId": "94f5432c-2f5c-47ca-9268-81e9c1ad65a4"
      }
    }
  }
}
