{
  "expo": {
    "name": "American Basilicas",
    "slug": "american-basilicas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "americanbasilicas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.americanbasilicas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used on this phone to list the basilicas nearest you. It isn't sent or saved."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f2e7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "org.americanbasilicas.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f2e7"
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used on this phone to list the basilicas nearest you. It isn't sent or saved."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "americanbasilicasorg",
    "description": "A pilgrim's map of the 94 Catholic minor basilicas of the United States."
  }
}